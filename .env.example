# NEVER PUT REAL API KEYS IN THIS FILE.
# This template is committed to Git; the real .env is git-ignored and excluded
# from the packaged .vsix.
#
# Configure secrets through the appropriate secure environment
# or VS Code SecretStorage mechanism.
#
# Prefer entering the key in the Verteon settings panel, which stores it in
# VS Code's secret storage when the host exposes it.

# Local Ollama needs no API key. It is the default provider.
# OLLAMA_URL=http://localhost:11434

# Used only when agent.provider is set to "groq".
GROQ_API_KEY=
